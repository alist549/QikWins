PORT = 3000
ENVIRONMENT = development # "production" for deployment
# STORE = memory          # run without MongoDB (data is lost on restart)
MONGODB_DEV_URL = mongodb://127.0.0.1:27017/qikwins
MONGODB_PROD_URL = <your-mongodb-atlas-connection-string>
# MONGODB_URL = overrides both of the above (Docker, CI)
JWT_SECRET = <a-long-random-string>

# ---- Game rules (cents; see config/games.js) ----
CURRENCY = USD
DEMO_BALANCE = 10000
MIN_STAKE = 25
MAX_STAKE = 500
HOP_OFF_FEE_RATE = 0.1
UNDERDOG_FEE_RATE = 0.1
